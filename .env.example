# =============================================================================
# TJournal Environment Variables
# =============================================================================
# Trage diese Variablen in Vercel (Project Settings -> Environment Variables)
# und lokal in deiner .env.local ein.
# Die Werte findest du im Supabase Dashboard unter: Project Settings -> API
# =============================================================================

# Supabase Project URL (öffentlich)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (öffentlich)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Key (NUR serverseitig, niemals veröffentlichen)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
